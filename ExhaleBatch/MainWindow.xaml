<Window x:Class="ExhaleBatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exhale Batch - xHE-AAC Encoder Frontend" Height="640" Width="840"
        WindowStartupLocation="CenterScreen"
        Background="#202020" Foreground="#FFFFFF"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>
        <ContextMenu x:Key="QueueContextMenu">
            <MenuItem Header="キューから削除" Click="MenuRemoveItem_Click"/>
            <Separator/>
            <MenuItem Header="元のファイルの場所を開く" Click="MenuOpenSourceLocation_Click"/>
            <MenuItem Header="出力先ファイルを開く" Click="MenuOpenOutputLocation_Click"/>
        </ContextMenu>

        <Style x:Key="QueueItemStyle" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="ContextMenu" Value="{StaticResource QueueContextMenu}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2B2B2B" CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderBrush="#3F3F3F" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="品質:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#CCCCCC"/>
                        <ComboBox x:Name="CmbPreset" Width="55" Height="26" SelectedIndex="5" Margin="0,0,12,0"
                                  ToolTip="exhale品質プリセット (0: 最低ビットレート 〜 9: 最高品質)">
                            <ComboBoxItem Content="0" ToolTip="約 12-16 kbps (超省容量・音声向け)"/>
                            <ComboBoxItem Content="1" ToolTip="約 16-24 kbps"/>
                            <ComboBoxItem Content="2" ToolTip="約 24-32 kbps"/>
                            <ComboBoxItem Content="3" ToolTip="約 32-48 kbps (ポッドキャスト・BGM)"/>
                            <ComboBoxItem Content="4" ToolTip="約 48-64 kbps (軽量音楽配信クオリティ)"/>
                            <ComboBoxItem Content="5" ToolTip="約 64-96 kbps (標準・バランス推奨)"/>
                            <ComboBoxItem Content="6" ToolTip="約 96-128 kbps (高音質)"/>
                            <ComboBoxItem Content="7" ToolTip="約 128-160 kbps (高忠実度)"/>
                            <ComboBoxItem Content="8" ToolTip="約 160-192 kbps (透過的音質)"/>
                            <ComboBoxItem Content="9" ToolTip="約 192-256+ kbps (最高品質)"/>
                        </ComboBox>

                        <TextBlock Text="並列数:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#CCCCCC"/>
                        <ComboBox x:Name="CmbConcurrency" Width="60" Height="26" ToolTip="同時にエンコードする最大曲数">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="4" IsSelected="True"/>
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="16"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="2">
                        <Button x:Name="BtnClear" Content="クリア" Width="65" Height="28" Margin="0,0,6,0" Click="BtnClear_Click"/>
                        <Button x:Name="BtnAddFolder" Content="フォルダ追加..." Width="105" Height="28" Margin="0,0,6,0" Click="BtnAddFolder_Click"/>
                        <Button x:Name="BtnAddFiles" Content="ファイル追加..." Width="95" Height="28" Margin="0,0,6,0" Click="BtnAddFiles_Click"/>
                        <Button x:Name="BtnStart" Content="一括変換開始" Width="110" Height="28" Margin="0,0,6,0" 
                                Background="#0067C0" Foreground="#FFFFFF" Click="BtnStart_Click" IsEnabled="False"/>
                        <Button x:Name="BtnCancel" Content="中断" Width="65" Height="28" 
                                Background="#A4262C" Foreground="#FFFFFF" Click="BtnCancel_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkCustomOutputDir" Content="出力先を指定:" Foreground="#CCCCCC"
                              VerticalAlignment="Center" Margin="0,0,8,0" Checked="ChkCustomOutputDir_Changed" Unchecked="ChkCustomOutputDir_Changed"/>
                    <TextBox x:Name="TxtOutputDir" Grid.Column="1" Height="26" VerticalAlignment="Center" Margin="0,0,8,0"
                             Background="#1E1E1E" Foreground="#FFFFFF" BorderBrush="#3F3F3F" IsReadOnly="True" IsEnabled="False"/>
                    <Button x:Name="BtnBrowseOutputDir" Grid.Column="2" Content="参照..." Width="75" Height="26" 
                            IsEnabled="False" Click="BtnBrowseOutputDir_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#2B2B2B" CornerRadius="6" BorderBrush="#3F3F3F" BorderThickness="1" Margin="0,0,0,10">
            <ListView x:Name="ListQueue" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" 
                      SelectionMode="Single" ItemContainerStyle="{StaticResource QueueItemStyle}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ファイル名" Width="260" DisplayMemberBinding="{Binding FileName}"/>
                        <GridViewColumn Header="ステータス" Width="100" DisplayMemberBinding="{Binding StatusMessage}"/>
                        <GridViewColumn Header="元ファイルパス" Width="420" DisplayMemberBinding="{Binding SourcePath}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <ProgressBar x:Name="PrgTotal" Grid.Row="2" Height="6" Margin="0,0,0,10" Minimum="0" Value="0"/>

        <Border Grid.Row="3" Background="#161616" CornerRadius="6" BorderBrush="#3F3F3F" BorderThickness="1">
            <TextBox x:Name="TxtLog" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                     FontFamily="Consolas" FontSize="11" IsReadOnly="True" Margin="6"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>
    </Grid>
</Window>
